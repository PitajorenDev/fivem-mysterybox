# Poort van de server
PORT=3001

# Anthropic API key voor foto-herkenning (verplicht voor "toevoegen via foto")
ANTHROPIC_API_KEY=
# Model voor herkenning (standaard claude-opus-5-5)
VISION_MODEL=claude-opus-5-5

# Optioneel: pokemontcg.io API key (hogere rate limits voor losse kaarten)
POKEMONTCG_API_KEY=

# Hoe vaak prijzen opnieuw ophalen (minuten). Cardmarket publiceert de price guide ~1x per dag;
# de app checkt elke X minuten of er nieuwe data is en pusht wijzigingen live naar de browser.
PRICE_REFRESH_MINUTES=30

# Welke Cardmarket-prijs als waarde telt: trend | avg1 | avg7 | avg30 | low | avg
PRICE_FIELD=trend

# Wachtwoord om de app te openen. Verplicht als je de app online zet!
# Leeg = geen wachtwoord (alleen voor lokaal gebruik).
APP_PASSWORD=
